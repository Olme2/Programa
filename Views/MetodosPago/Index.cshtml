@model IEnumerable<MetodosVM.ListarMetodosPagoVM>
@{
    ViewData["Title"] = "Métodos de Pago";
}

<h1>Métodos de Pago</h1>
<p>Gestiona las formas en que tus clientes pueden pagar.</p>

<table class="table table-hover mt-4">
    <thead class="table-dark">
        <tr>
            <th>Método de Pago</th>
            <th style="width: 200px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var metodo in Model)
        {
            <tr>
                <td>@metodo.Metodo</td>
                <td>
                    <a asp-action="Modificar" asp-route-id="@metodo.IdMetodo" class="btn btn-warning btn-sm">Modificar</a>
                    
                    @if (metodo.EsEliminable)
                    {
                        <a asp-action="Eliminar" asp-route-id="@metodo.IdMetodo" class="btn btn-danger btn-sm">Eliminar</a>
                    }
                    else
                    {
                        <a class="btn btn-secondary btn-sm disabled" title="No se puede eliminar, está en uso en ventas.">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Alta" class="btn btn-success btn-lg btn-float">+</a>