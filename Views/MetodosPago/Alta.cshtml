@model MetodosVM.AltaMetodoPagoVM

<h2>Agregar Método de Pago</h2>

<form asp-action="Alta" method="post">
    <div class="form-group">
        <label asp-for="Metodo"></label>
        <input asp-for="Metodo" class="form-control" />
        <span asp-validation-for="Metodo" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form> 