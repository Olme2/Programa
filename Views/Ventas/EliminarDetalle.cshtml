@model DetallesVentasVM.ListarDetallesVentaVM
@{
    ViewData["Title"] = "Eliminar Detalle de Venta";
}
<h2>Eliminar Detalle de Venta</h2>
<div class="alert alert-danger">
    <strong>¿Estás seguro que deseas eliminar este producto de la venta?</strong>
</div>
<dl class="row">
    <dt class="col-sm-3">Producto</dt>
    <dt class="col-sm-3">Cantidad</dt> //arreglar
    <dd class="col-sm-9">@Model.Cantidad</dd>
    <dt class="col-sm-3">Promoción</dt>
    <dd class="col-sm-9">@(Model.Promocion ? "Sí" : "No")</dd>
    <dt class="col-sm-3">Precio Promo</dt>
    <dd class="col-sm-9">@Model.PrecioPromo.ToString("C")</dd>
    <dt class="col-sm-3">Costo Promo</dt>
    <dd class="col-sm-9">@Model.CostoPromo.ToString("C")</dd>
</dl>
<form asp-action="EliminarDetalle" method="post">
    <input type="hidden" name="idVenta" value="@Model.IdVenta" />
    <input type="hidden" name="idProducto" value="@Model.IdProducto" />
    <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
    <a asp-action="VerDetalles" asp-route-id="@Model.IdVenta" class="btn btn-secondary">Cancelar</a>
</form> using VentasVM;
#line default
