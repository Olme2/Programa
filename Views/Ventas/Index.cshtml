@model VentasVM.IndexVentasVM
@{
    ViewData["Title"] = "Listado de Ventas";
}

<div class="container-fluid">
    <h1>Listado de Ventas</h1>
    <p></p>
    <form id="filtro-form" class="row g-3 align-items-center p-3 mb-3 bg-light border rounded">
        <div class="row">
            <h2 class="col-md-3">Filtros</h2>
            <div class="col-md-6"></div>
            <h2 class="col-md-3">Total: <span id="total-general-display" class="fw-bold text-success"></span></h2>
        </div>
        <div class="col-xl-2 col-md-6">
            <label asp-for="FechaInicio" class="form-label">Fecha de Inicio</label>
            <input asp-for="FechaInicio" type="date" class="form-control filtro-control" />
        </div>
        <div class="col-xl-2 col-md-6">
            <label asp-for="FechaFin" class="form-label">Fecha de Fin</label>
            <input asp-for="FechaFin" type="date" class="form-control filtro-control" />
        </div>
        <div class="col-xl-2 col-md-6">
            <label asp-for="IdMetodoPago" class="form-label"></label>
            <select asp-for="IdMetodoPago" class="form-select filtro-control">
                <option value="" selected>Todos</option>
                @foreach(var metodo in Model.MetodosPago){
                    <option value="@metodo.IdMetodo">@metodo.Metodo</option>
                }
            </select>
        </div>
        <div class="col-xl-6 col-md-6">
            <label asp-for="Busqueda" class="form-label">Buscar</label>
            <input asp-for="Busqueda" class="form-control filtro-control" placeholder="Producto o Promoción..." />
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover table-sm">
            <thead class="table-dark">
                <tr>
                    <th>Promociones/Productos</th>
                    <th>Método de Pago</th>
                    <th>Total</th>
                    <th>Fecha y Hora</th>
                    <th style="width: 220px;">Acciones</th>
                </tr>
            </thead>
            <tbody id="tabla-ventas-body">
                <partial name="_VentasTabla" model="Model.Ventas" />
            </tbody>
        </table>
    </div>
</div>

<a asp-action="Alta" class="btn btn-success btn-lg btn-float">+</a>

@section Scripts {
    <script>
        $(document).ready(function() {
            let debounceTimer;

            function actualizarEnlaces(queryString) {
                // Actualiza el botón "Registrar Venta"
                const btnAlta = $('#btn-registrar-venta'); // Asegúrate de que tu botón tenga este ID
                if (btnAlta.length) {
                    const baseUrl = btnAlta.attr('href').split('?')[0];
                    btnAlta.attr('href', baseUrl + queryString);
                }

                // Actualiza los botones de la tabla
                $('#tabla-ventas-container a').each(function() {
                    const link = $(this);
                    const baseUrl = link.attr('href').split('?')[0];
                    link.attr('href', baseUrl + queryString);
                });
            }

            function filtrarVentas() {
                const fechaDesde = $('#FechaDesde').val();
                const fechaHasta = $('#FechaHasta').val();
                const idMetodo = $('#IdMetodo').val();
                const busqueda = $('#Busqueda').val();

                const filtroData = {
                    fechaDesde: fechaDesde,
                    fechaHasta: fechaHasta,
                    idMetodo: idMetodo,
                    busqueda: busqueda
                };

                $.ajax({
                    url: '@Url.Action("FiltrarVentas", "Ventas")',
                    type: 'GET',
                    data: filtroData,
                    success: function(response) {
                        $('#tabla-ventas-container').html(response.tablaHtml);
                        $('#total-ventas-filtradas').text(response.totalVentas);
                        
                        // --- INICIO DE LA CORRECCIÓN #2 ---
                        // Después de cada filtro exitoso, actualizamos los enlaces
                        const queryString = '?' + new URLSearchParams(filtroData).toString();
                        actualizarEnlaces(queryString);
                        // --- FIN DE LA CORRECCIÓN #2 ---
                    },
                    error: function() {
                        alert('Ocurrió un error al filtrar las ventas.');
                    }
                });
            }
            function calcularYMostrarTotalGeneral() {
                let totalGeneral = 0;
            
                // 1. Buscamos todas las celdas que contienen el total de cada venta.
                $('#tabla-ventas-body .totalProducto').each(function() {
                    
                    // 2. Limpiamos el texto para convertirlo en un número que JavaScript entienda.
                    // Ej: "$1.500,75" -> "1500.75"
                    const textoCelda = $(this).text();
                    const valorNumerico = parseFloat(textoCelda.replace('$', '').replace(/\./g, '').replace(',', '.')) || 0;
                    
                    // 3. Lo sumamos al total general.
                    totalGeneral += valorNumerico;
                });
            
                // 4. Formateamos el resultado y lo mostramos en el span que creamos.
                const totalFormateado = totalGeneral.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' });
                $('#total-general-display').text(totalFormateado);
            }
            // Actualizar tabla al cambiar cualquier filtro
            $('.filtro-control').on('change', function() {
                actualizarTablaVentas();
            });
            // Actualizar al escribir en el buscador
             $('#Busqueda').on('keyup', function() {
                actualizarTablaVentas();
            });
            calcularYMostrarTotalGeneral();
        });
    </script>
}