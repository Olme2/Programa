@model List<VentaConDetallesViewModel>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

@{
    ViewBag.Title = "Ventas del día";
    var fechaSeleccionada = ViewBag.FechaSeleccionada ?? DateTime.Now.ToString("yyyy-MM-dd");
}
<h2 style="font-size:1.2rem;">Ventas del día</h2>
<form method="get" asp-action="Index" style="margin-bottom:10px; display:flex; align-items:center; gap:10px;">
    <label for="fecha" style="font-size:0.9rem;">Buscar por fecha:</label>
    <input type="date" id="fecha" name="fecha" value="@fechaSeleccionada" style="font-size:0.9rem; padding:2px 4px; width:130px;" />
    <button type="submit" class="btn btn-sm btn-primary">Buscar</button>
    <a asp-action="Create" class="btn btn-sm btn-success" style="margin-left:10px;">Nueva Venta</a>
</form>
@if (Model.Count == 0)
{
    <div class="alert alert-info" style="font-size:0.95rem;">No hay ventas registradas para la fecha seleccionada.</div>
}
else
{
    <table class="table table-sm table-bordered" style="font-size:0.95rem; width:auto; min-width:600px;">
        <thead class="table-light">
            <tr>
                <th style="width:80px;">Hora</th>
                <th style="width:100px;">Total</th>
                <th style="width:120px;">Método de Pago</th>
                <th style="width:100px;">Costo</th>
                <th style="width:100px;">Ganancia</th>
                <th style="width:90px;">% Ganancia</th>
                <th style="width:120px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Hora.ToString("HH:mm")</td>
                <td>$@v.Total.ToString("N2")</td>
                <td>@v.MetodoDePago</td>
                <td>$@v.Costo.ToString("N2")</td>
                <td>$@v.Ganancia.ToString("N2")</td>
                <td>@v.PorcentajeGanancia.ToString("N2")%</td>
                <td>
                    <a asp-action="Details" asp-route-id="@v.IdVenta" class="btn btn-sm btn-info">Ver</a>
                    <a asp-action="Edit" asp-route-id="@v.IdVenta" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@v.IdVenta" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
} 