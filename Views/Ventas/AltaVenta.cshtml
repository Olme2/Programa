@model VentasVM.AltaVentaVM
@{
    ViewData["Title"] = "Registrar Venta";
}
<h2>Registrar Nueva Venta</h2>
<form asp-action="AltaVenta" method="post" class="row g-3">
    <div class="col-md-4">
        <label asp-for="IdMetodoPago" class="form-label">Método de Pago</label>
        <select asp-for="IdMetodoPago" class="form-select">
            @foreach(var metodo in Model.MetodosPago){
                <option value="@metodo.IdMetodo">@metodo.Metodo</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Detalle" class="form-label">Detalle</label>
        <input asp-for="Detalle" class="form-control" />
    </div>
    <div class="col-md-2">
        <label asp-for="Fecha" class="form-label">Fecha</label>
        <input asp-for="Fecha" type="date" class="form-control" value="@(Model.Fecha.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-md-2">
        <label asp-for="Hora" class="form-label">Hora</label>
        <input asp-for="Hora" type="time" class="form-control" value="@(Model.Hora.ToString("HH:mm"))" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Registrar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form> 