@model VentasVM.AltaVentaVM
@{
    ViewData["Title"] = "Registrar Venta";
}

<form asp-action="Alta" method="post" id="form-venta">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <h1>Registrar Nueva Venta</h1>
    <hr />

    <div class="row">
        <div class="col-lg-8">
            @* --- DATOS GENERALES DE LA VENTA --- *@
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h4>Datos Generales</h4></div>
                <div class="card-body row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="IdMetodo" class="form-label"></label>
                        <select asp-for="IdMetodo" asp-items="Model.MetodosDePago" class="form-select"></select>
                        <span asp-validation-for="IdMetodo" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Fecha" class="form-label"></label>
                        <input asp-for="Fecha" type="date" class="form-control" />
                        <span asp-validation-for="Fecha" class="text-danger"></span>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label asp-for="Hora" class="form-label"></label>
                        <input asp-for="Hora" type="time" class="form-control" />
                        <span asp-validation-for="Hora" class="text-danger"></span>
                    </div>
                     <div class="col-md-3 mb-3">
                        <label asp-for="Recargo" class="form-label"></label>
                        <div class="input-group">
                             <input asp-for="Recargo" type="number" step="0.01" min="0" class="form-control" />
                             <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="Recargo" class="text-danger"></span>
                    </div>
                </div>
            </div>

            @* --- DETALLES DE PRODUCTOS --- *@
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h5>Productos Individuales</h5></div>
                <div class="card-body">
                    <div id="detalles-productos-container">
                        @* Renderiza los detalles existentes si la validación falló *@
                        @for (var i = 0; i < Model.DetallesVenta.Count; i++)
                        {
                            <partial name="Partials/_DetalleVentaItem" for="DetallesVenta[i]" view-data='new ViewDataDictionary(ViewData) { { "index", i } }' />
                        }
                    </div>
                    <button type="button" id="btn-agregar-producto" class="btn btn-outline-primary w-100 mt-2">+ Añadir Producto</button>
                </div>
            </div>

            @* --- DETALLES DE PROMOCIONES --- *@
            <div class="card shadow-sm">
                <div class="card-header"><h5>Promociones</h5></div>
                <div class="card-body">
                    <div id="detalles-promociones-container">
                        @* Renderiza las promociones existentes si la validación falló *@
                        @for (var i = 0; i < Model.VentaPromociones.Count; i++)
                        {
                            <partial name="Partials/_VentaPromocionItem" for="VentaPromociones[i]" view-data='new ViewDataDictionary(ViewData) { { "index", i } }' />
                        }
                    </div>
                    <button type="button" id="btn-agregar-promocion" class="btn btn-outline-primary w-100 mt-2">+ Añadir Promoción</button>
                </div>
            </div>
        </div>

        @* --- COLUMNA DE RESUMEN --- *@
        <div class="col-lg-4">
            <div class="summary-card" style="position: sticky; top: 20px;">
                <h4>Resumen de la Venta</h4>
                <hr>
                <div class="summary-item">
                    <span>Subtotal:</span>
                    <span id="subtotal-display">$0.00</span>
                </div>
                <div class="summary-item">
                    <span>Recargo:</span>
                    <span id="recargo-display">$0.00</span>
                </div>
                <div class="summary-item total fs-4">
                    <span>TOTAL:</span>
                    <span id="total-display" class="text-success">$0.00</span>
                </div>

                @* Nuevo campo de Detalle (Opcional) *@
                <div class="mt-3">
                    <label asp-for="Detalle" class="form-label">Detalle (Opcional)</label>
                    <textarea asp-for="Detalle" class="form-control" rows="3"></textarea>
                </div>

                 <div class="mt-4">
                    <button type="submit" id="envio" class="btn btn-primary btn-lg w-100">Registrar Venta</button>
                    <a asp-action="Index" asp-controller="Home" class="btn btn-secondary w-100 mt-2">Cancelar</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
   @{<partial name="_ValidationScriptsPartial"/>}
    
    <script>
        $(document).ready(function () {
            // --- INICIALIZACIÓN (La parte más importante de la corrección) ---
            // 1. Buscamos TODOS los buscadores que ya existen (porque la validación falló) y los inicializamos.
            $('.producto-search').each(function() {
                inicializarSelect2Productos($(this));
            });
            $('.promocion-search').each(function() {
                inicializarSelect2Promociones($(this));
            });
            
            // 2. Hacemos el cálculo inicial para que los totales se muestren correctamente.
            recalcularTotalVenta();
            
            function parseLocalFloat(valor) {
                if (!valor) return 0;
                return parseFloat(String(valor).replace(',', '.')) || 0;
            }

            function recalcularTotalVenta() {
                let subtotalProductos = 0;
                let subtotalPromociones = 0;

                $('.detalle-item-producto').each(function () {
                    const fila = $(this);
                    const precioUnitario = parseLocalFloat(fila.find('.precio-unitario-hidden').val());
                    const cantidad = parseLocalFloat(fila.find('.cantidad-producto').val());
                    const subtotal = precioUnitario * cantidad;
                    fila.find('.subtotal-display').text(subtotal.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }));
                    subtotalProductos += subtotal;
                });

                $('.detalle-item-promocion').each(function () {
                    const fila = $(this);
                    const precioUnitario = parseLocalFloat(fila.find('.precio-promo-hidden').val());
                    const cantidad = parseLocalFloat(fila.find('.cantidad-promocion').val());
                    const subtotal = precioUnitario * cantidad;
                    fila.find('.subtotal-display').text(subtotal.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }));
                    subtotalPromociones += subtotal;
                });

                const subtotalGeneral = subtotalProductos + subtotalPromociones;
                const recargoPorcentaje = parseLocalFloat($('#Recargo').val()) / 100;
                const montoRecargo = subtotalGeneral * recargoPorcentaje;
                const totalFinal = subtotalGeneral + montoRecargo;

                $('#subtotal-display').text(subtotalGeneral.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }));
                $('#recargo-display').text(montoRecargo.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }));
                $('#total-display').text(totalFinal.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }));
            }

            function inicializarSelect2Productos(selector) {
                selector.select2({
                    placeholder: "-- Buscar producto --",
                    ajax: {
                        url: '@Url.Action("BuscarProductosParaVenta", "Ventas")',
                        dataType: 'json',
                        delay: 0,
                        data: function (params) {
                            var idsExcluidos = [];
                            $('.producto-search').not($(this)).each(function() {
                                if ($(this).val()) { idsExcluidos.push($(this).val()); }
                            });
                            return { term: params.term, excluir: idsExcluidos };
                        },
                        processResults: function (data) { return { results: data }; }
                    }
                }).on('select2:select', function (e) {
                    const fila = $(this).closest('.detalle-item-producto');
                    fila.find('.precio-unitario-hidden').val(e.params.data.precio);
                    fila.find('.costo-unitario-hidden').val(e.params.data.costo);
                    recalcularTotalVenta();
                });
            }
            
            function inicializarSelect2Promociones(selector) {
                selector.select2({
                    placeholder: "-- Buscar promoción --",
                    ajax: {
                        url: '@Url.Action("BuscarPromocionesParaVenta", "Ventas")',
                        dataType: 'json',
                        delay: 50,
                        data: function (params) {
                            var idsExcluidos = [];
                            $('.promocion-search').not($(this)).each(function() {
                                if ($(this).val()) { idsExcluidos.push($(this).val()); }
                            });
                            return { term: params.term, excluir: idsExcluidos };
                        },
                        processResults: function (data) { return { results: data }; }
                    }
                }).on('select2:select', function (e) {
                    const fila = $(this).closest('.detalle-item-promocion');
                    fila.find('.precio-promo-hidden').val(e.params.data.precio);
                    fila.find('.costo-promo-hidden').val(e.params.data.costo);
                    recalcularTotalVenta();
                });
            }

            $('#btn-agregar-producto').on('click', function() {
                const container = $('#detalles-productos-container');
                const nuevoIndex = $('.detalle-item-producto').length;
                $.get('@Url.Action("ObtenerVistaDetalleVenta")', { index: nuevoIndex }, function(nuevaFilaHtml) {
                    const nuevaFila = $(nuevaFilaHtml);
                    container.append(nuevaFila);
                    inicializarSelect2Productos(nuevaFila.find('.producto-search'));
                });
            });

            $('#btn-agregar-promocion').on('click', function() {
                const container = $('#detalles-promociones-container');
                const nuevoIndex = $('.detalle-item-promocion').length;
                $.get('@Url.Action("ObtenerVistaVentaPromocion")', { index: nuevoIndex }, function(nuevaFilaHtml) {
                    const nuevaFila = $(nuevaFilaHtml);
                    container.append(nuevaFila);
                    inicializarSelect2Promociones(nuevaFila.find('.promocion-search'));
                });
            });

            $('#detalles-productos-container, #detalles-promociones-container').on('click', '.btn-eliminar-detalle', function () {
                $(this).closest('.row').remove();
                reindexarFilas();
                recalcularTotalVenta();
            });

            function reindexarFilas() {
                $('.detalle-item-producto').each(function(index, item) {
                    $(item).find('[name^="DetallesVenta"]').each(function() {
                        this.name = this.name.replace(/\[\d+\]/, `[${index}]`);
                    });
                });
                $('.detalle-item-promocion').each(function(index, item) {
                    $(item).find('[name^="VentaPromociones"]').each(function() {
                        this.name = this.name.replace(/\[\d+\]/, `[${index}]`);
                    });
                });
            }
             // --- NUEVOS EVENTOS PARA CÁLCULOS EN VIVO ---
            $('#Recargo').on('input', recalcularTotalVenta);
            $('#detalles-productos-container').on('input', '.cantidad-producto', recalcularTotalVenta);
            $('#detalles-promociones-container').on('input', '.cantidad-promocion', recalcularTotalVenta);
            $('#form-venta').on('submit', function(e) {
                $('#Recargo, .cantidad-producto, .cantidad-promocion').each(function() {
                    const input = $(this);
                    if (input.val()) { input.val(input.val().replace(',', '.')); }
                });
                reindexarFilas();
            });

        });
    </script>
}