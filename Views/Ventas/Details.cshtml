@model VentaConDetallesViewModel
@{
    ViewBag.Title = "Detalle de Venta";
}
<h2 style="font-size:1.2rem;">Detalle de Venta</h2>
<div class="mb-2" style="font-size:0.98rem;">
    <b>Fecha:</b> @Model.Fecha.ToString("dd/MM/yyyy") &nbsp; <b>Hora:</b> @Model.Hora.ToString("HH:mm")<br />
    <b>Método de Pago:</b> @Model.MetodoDePago<br />
    <b>Total:</b> $@Model.Total.ToString("N2") &nbsp; <b>Costo:</b> $@Model.Costo.ToString("N2") &nbsp; <b>Ganancia:</b> $@Model.Ganancia.ToString("N2") &nbsp; <b>% Ganancia:</b> @Model.PorcentajeGanancia.ToString("N2")%<br />
    @if (!string.IsNullOrEmpty(Model.Detalle)) { <b>Detalle:</b> @Model.Detalle }
</div>
<h5 style="font-size:1.05rem; margin-top:18px;">Productos vendidos</h5>
<table class="table table-sm table-bordered" style="font-size:0.95rem; min-width:700px;">
    <thead class="table-light">
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Promoción</th>
            <th>Precio Unitario</th>
            <th>Costo Unitario</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var d in Model.Detalles)
    {
        var precio = d.Promocion ? d.PrecioPromo : (d.NombreProducto != null ? 0 : 0); // El precio real debería venir del producto, pero aquí solo mostramos lo que se guardó
        var costo = d.Promocion ? d.CostoPromo : (d.NombreProducto != null ? 0 : 0);
        <tr>
            <td>@d.NombreProducto</td>
            <td>@d.Cantidad.ToString("N3")</td>
            <td>@(d.Promocion ? "Sí" : "No")</td>
            <td>$@(d.Promocion ? d.PrecioPromo.ToString("N2") : "-")</td>
            <td>$@(d.Promocion ? d.CostoPromo.ToString("N2") : "-")</td>
            <td>$@((d.Promocion ? d.PrecioPromo : 0) * d.Cantidad).ToString("N2")</td>
        </tr>
    }
    </tbody>
</table>
<a asp-action="Index" class="btn btn-sm btn-secondary">Volver</a> 