@model VentasPromocionesVM.AltaVentaPromocionVM
@{
    var index = ViewData["index"];
}
<div class="row detalle-item-promocion align-items-center mb-3 p-2 border rounded">
    @* Campos ocultos para enviar el precio y costo al servidor *@
    <input type="hidden" name="VentaPromociones[@index].PrecioPromo" class="precio-promo-hidden" />
    <input type="hidden" name="VentaPromociones[@index].CostoPromo" class="costo-promo-hidden" />

    <div class="col-md-6">
        <label class="form-label">Promoción</label>
        <select name="VentaPromociones[@index].IdPromocion" class="form-control promocion-search">
             @if(Model.IdPromocion > 0)
            {
                <option value="@Model.IdPromocion" selected>@Model.NombrePromocion</option>
            }
        </select>
        @* CORRECCIÓN: Apuntamos directamente a la propiedad del modelo *@
        <span asp-validation-for="IdPromocion" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label class="form-label">Cantidad</label>
        <input name="VentaPromociones[@index].Cantidad" type="number" step="1" min="1" class="form-control cantidad-promocion" value="@Model.Cantidad" />
        @* CORRECCIÓN: Apuntamos directamente a la propiedad del modelo *@
        <span asp-validation-for="Cantidad" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label class="form-label">Subtotal</label>
        <p class="form-control-plaintext fw-bold subtotal-display">$0.00</p>
    </div>
    <div class="col-md-1 text-end">
        <button type="button" class="btn btn-danger btn-sm btn-eliminar-detalle">&times;</button>
    </div>
</div>