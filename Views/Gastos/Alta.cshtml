@model GastosVM.AltaGastoVM
@{
    ViewData["Title"] = "Registrar Gasto";
}

<form asp-action="Alta" method="post">
    @Html.AntiForgeryToken()
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">Nuevo Gasto</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Fecha" class="form-label">Fecha</label>
                            <input asp-for="Fecha" type="date" class="form-control" />
                            <span asp-validation-for="Fecha" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Monto" class="form-label">Monto ($)</label>
                            <input asp-for="Monto" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="Monto" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label">Concepto</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Luz, Gas, Bolsas, Aceite..." />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Observacion" class="form-label">Observación (opcional)</label>
                            <input asp-for="Observacion" class="form-control" placeholder="Detalle adicional..." />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">💾 Guardar</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
