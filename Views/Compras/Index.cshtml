@model ComprasVM.IndexComprasVM
@{
    ViewData["Title"] = "Listado de Compras";
}

<div class="container-fluid">
    <div class="row col-md-12">
        <form id="filtro-form" class="row g-3 align-items-center p-3 mb-3 bg-light border rounded">
            <div class="row">
                <h2 class="col-md-4">Filtros</h2>
                <div class="col-md-4"></div>
                <div class="col-md-4">
                    <a asp-action="ResetearFiltros" class="btn btn-secondary w-100">
                        <i class="bi bi-arrow-counterclockwise"></i> Resetear Filtros
                    </a>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <label asp-for="FechaInicio" class="form-label">Fecha de Inicio</label>
                <input asp-for="FechaInicio" type="date" class="form-control filtro-control" />
            </div>
            <div class="col-xl-3 col-md-6">
                <label asp-for="FechaFin" class="form-label">Fecha de Fin</label>
                <input asp-for="FechaFin" type="date" class="form-control filtro-control" />
            </div>
            <div class="col-xl-3 col-md-6">
                <label asp-for="IdProveedor" class="form-label"></label>
                <select asp-for="IdProveedor" class="form-select filtro-control">
                    <option value="" selected>Todos</option>
                    @foreach(var prov in Model.Proveedores){
                        <option value="@prov.IdProveedor">@prov.Proveedor</option>
                    }
                </select>
            </div>
        </form>
    </div>
    <div class="row col-md-12">
        <h1 class="col-md-4">Listado de Compras</h1>
        <h1 class="col-md-4">Cantidad: <span id="cantidad-general-display" class="fw-bold"></span></h1>
        <h1 class="col-md-4">Total: <span id="total-general-display" class="fw-bold text-success"></span></h1>
    </div>
    <div class="row col-md-12"><hr></div>
    <div class="table-responsive row col-md-12">
        <table class="table table-hover table-sm">
            <thead class="table-dark">
                <tr>
                    <th>N°</th>
                    <th>Productos</th>
                    <th>Proveedor</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Detalle</th>
                    <th style="width: 150px;">Acciones</th>
                </tr>
            </thead>
            <tbody id="tabla-compras-body">
                <partial name="_ComprasTabla" model="Model.Compras" />
            </tbody>
        </table>
    </div>
</div>

<a asp-action="Alta" class="btn btn-success btn-lg btn-float">+</a>

@section Scripts {
    <script>
        $(document).ready(function () {
            function actualizarTablaVentas() {
                var data = {
                    FechaInicio: $('#FechaInicio').val(),
                    FechaFin: $('#FechaFin').val(),
                    IdProveedor: $('#IdProveedor').val()
                };

                $.ajax({
                    url: '@Url.Action("_BuscarCompras", "Compras")',
                    type: 'POST', // Changed to POST to match Controller if needed, or check Controller method attribute
                    data: data,
                    success: function (result) {
                        $('#tabla-compras-body').html(result);
                        calcularYMostrarTotalGeneral();
                    },
                    error: function () {
                        alert("Error al cargar los datos. Intente nuevamente.");
                    }
                });
            }
            function calcularYMostrarTotalGeneral() {
                let totalGeneral = 0;
                let cantidadGeneral = $('#tabla-compras-body .compra').length;
                let num = cantidadGeneral;
                
                $('#tabla-compras-body .compra').each(function() {
                    const textoTotal = $(this).find('.totalCompra').text();
                    const valorNumerico = parseFloat(textoTotal.replace('$', '').replace(/\./g, '').replace(',', '.')) || 0;

                    totalGeneral += valorNumerico;
                    $(this).find(".numeroCompra").text(num--);
                });

                const totalFormateado = totalGeneral.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' });
                $('#total-general-display').text(totalFormateado);
                $('#cantidad-general-display').text(cantidadGeneral);
            }

            $('.filtro-control').on('change', function() {
                actualizarTablaVentas();
            });

            calcularYMostrarTotalGeneral();
        });
    </script>
}