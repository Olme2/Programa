@model ComprasVM.IndexComprasVM
@{
    ViewData["Title"] = "Compras";
}

<!-- Filtros -->
<div class="filter-panel">
    <div class="filter-title">Filtros</div>
    <form id="filtro-form" class="row g-2 align-items-end">
        <div class="col-xl-3 col-md-4">
            <label asp-for="FechaInicio" class="form-label">Fecha Inicio</label>
            <input asp-for="FechaInicio" type="date" class="form-control filtro-control" />
        </div>
        <div class="col-xl-3 col-md-4">
            <label asp-for="FechaFin" class="form-label">Fecha Fin</label>
            <input asp-for="FechaFin" type="date" class="form-control filtro-control" />
        </div>
        <div class="col-xl-3 col-md-4">
            <label asp-for="IdProveedor" class="form-label">Proveedor</label>
            <select asp-for="IdProveedor" class="form-select filtro-control">
                <option value="" selected>Todos</option>
                @foreach(var prov in Model.Proveedores){
                    <option value="@prov.IdProveedor">@prov.Proveedor</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <a asp-action="ResetearFiltros" class="btn btn-secondary">↺ Resetear</a>
        </div>
    </form>
</div>

<!-- Stats -->
<div class="stat-row">
    <div class="stat-chip">
        <div class="label">Cantidad</div>
        <div class="value" id="cantidad-general-display">—</div>
    </div>
    <div class="stat-chip accent">
        <div class="label">Total</div>
        <div class="value" id="total-general-display">—</div>
    </div>
</div>

<!-- Tabla -->
<div class="table-wrapper">
    <table class="table table-hover table-sm">
        <thead>
            <tr>
                <th>N°</th>
                <th>Productos</th>
                <th>Proveedor</th>
                <th>Fecha</th>
                <th>Total</th>
                <th>Detalle</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-compras-body">
            <partial name="_ComprasTabla" model="Model.Compras" />
        </tbody>
    </table>
</div>

<a asp-action="Alta" class="btn btn-float">+</a>

@section Scripts {
    <script>
        $(document).ready(function () {
            function actualizarTablaCompras() {
                $.ajax({
                    url: '@Url.Action("_BuscarCompras", "Compras")',
                    type: 'POST',
                    data: { FechaInicio: $('#FechaInicio').val(), FechaFin: $('#FechaFin').val(), IdProveedor: $('#IdProveedor').val() },
                    success: function (result) {
                        $('#tabla-compras-body').html(result);
                        calcularYMostrarTotalGeneral();
                    },
                    error: function () { alert("Error al cargar los datos."); }
                });
            }
            function calcularYMostrarTotalGeneral() {
                let totalGeneral = 0;
                let cantidadGeneral = $('#tabla-compras-body .compra').length;
                let num = cantidadGeneral;
                $('#tabla-compras-body .compra').each(function() {
                    const textoTotal = $(this).find('.totalCompra').text();
                    totalGeneral += parseFloat(textoTotal.replace('$', '').replace(/\./g, '').replace(',', '.')) || 0;
                    $(this).find(".numeroCompra").text(num--);
                });
                $('#total-general-display').text(totalGeneral.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }));
                $('#cantidad-general-display').text(cantidadGeneral);
            }
            $('.filtro-control').on('change', function() { actualizarTablaCompras(); });
            calcularYMostrarTotalGeneral();
        });
    </script>
}