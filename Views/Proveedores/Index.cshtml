@model List<ProveedoresVM.ListarProveedoresVM>
@{
    ViewData["Title"] = "Proveedores";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>Listado de Proveedores</h1>
<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-3 align-items-center">
        <div class="col-sm-5">
            <input type="text" name="busqueda" class="form-control" placeholder="Buscar por nombre..." value="@ViewData["BusquedaActual"]" />
        </div>

        <div class="col-sm-4">
            <select name="filtroDeuda" class="form-select">
                <option value="todos" selected="@(ViewData["FiltroDeudaActual"]?.ToString() == "todos")">Mostrar Todos</option>
                <option value="conDeuda" selected="@(ViewData["FiltroDeudaActual"]?.ToString() == "conDeuda")">Sólo con Deuda</option>
                <option value="sinDeuda" selected="@(ViewData["FiltroDeudaActual"]?.ToString() == "sinDeuda")">Sólo sin Deuda</option>
            </select>
        </div>

        <div class="col-sm-3">
            <button type="submit" class="btn btn-primary w-100">Filtrar / Buscar</button>
        </div>
    </div>
</form>
<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Proveedor</th>
            <th>Contacto</th>
            <th>Deuda</th>
            <th style="width: 200px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var proveedor in Model)
        {
            // LÓGICA CONDICIONAL PARA EL ESTILO DE LA FILA:
            // Si el proveedor tiene deuda, la fila tendrá un fondo rojo claro.
            string filaConDeudaClass = proveedor.Debo > 0 ? "table-danger" : "";
            
            <tr class="@filaConDeudaClass">
                <td>@proveedor.Proveedor</td>
                <td>@(proveedor.Contacto ?? "Sin datos")</td>
                <td>@proveedor.Debo.ToString("C")</td>
                <td>
                    <a asp-action="Modificar" asp-route-id="@proveedor.IdProveedor" class="btn btn-warning btn-sm">Modificar</a>

                    @if (proveedor.EsEliminable)
                    {
                        <a asp-action="Eliminar" asp-route-id="@proveedor.IdProveedor" class="btn btn-danger btn-sm">Eliminar</a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm" disabled title="No se puede eliminar, tiene productos asociados.">Eliminar</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Alta" class="btn btn-success btn-lg btn-float">+</a>