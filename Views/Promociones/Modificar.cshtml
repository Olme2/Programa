@model PromocionesVM.ModificarPromocionVM
@{
    ViewData["Title"] = "Modificar Promoción";
}

@if (Model.EsModificable)
{
    @* --- CASO 1: LA PROMOCIÓN SÍ SE PUEDE MODIFICAR (Formulario Dinámico Completo) --- *@

    <form asp-action="Modificar" method="post" id="form-promocion">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="IdPromocion" />
        <input type="hidden" asp-for="EsModificable" />
        <h1>Modificar Promoción: @Model.Promocion</h1>
        <hr />

        <div class="row">
            <div class="col-md-7">
                @* --- DATOS GENERALES --- *@
                <div class="card shadow-sm mb-4">
                    <div class="card-header"><h4>Datos Generales</h4></div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Promocion" class="form-label"></label>
                            <input asp-for="Promocion" class="form-control" />
                            <span asp-validation-for="Promocion" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label asp-for="Inicio" class="form-label"></label>
                                <input asp-for="Inicio" type="date" class="form-control" />
                                <span asp-validation-for="Inicio" class="text-danger"></span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label asp-for="Fin" class="form-label">Fecha de Fin (Opcional)</label>
                                <input asp-for="Fin" type="date" class="form-control" />
                                <span asp-validation-for="Fin" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- DETALLES DE PRODUCTOS (Dinámicos) --- *@
                <div class="card shadow-sm">
                    <div class="card-header"><h4>Productos Incluidos</h4></div>
                    <div class="card-body">
                        <div id="detalles-container">
                            @* --- INICIO DE LA CORRECCIÓN ---
                               Usamos un bucle 'for' y la vista parcial estándar '_ModificarDetallePromocionItem.cshtml'
                            *@
                            @if (Model.DetallesPromocion != null)
                            {
                                for (int i = 0; i < Model.DetallesPromocion.Count; i++)
                                {
                                    <partial name="_ModificarDetallePromocionItem" model="Model.DetallesPromocion[i]" />
                                }
                            }
                        </div>
                        <button type="button" id="btn-agregar-detalle" class="btn btn-success w-100 mt-2">+ Añadir Producto</button>
                    </div>
                </div>
            </div>

            @* --- COLUMNA DE RESUMEN --- *@
            <div class="col-md-5">
                <div class="summary-card">
                    <h4>Resumen de la Promoción</h4>
                    <hr>
                    <div class="mb-3">
                        <label asp-for="Precio" class="form-label fs-5">Precio de Venta Final</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control form-control-lg" />
                        </div>
                        <span asp-validation-for="Precio" class="text-danger"></span>
                    </div>
                    <div class="summary-item">
                        <span>Costo Total:</span>
                        <span id="costo-total-display" class="fw-bold text-danger">$0.00</span>
                    </div>
                    <div class="summary-item total">
                        <span>GANANCIA:</span>
                        <span id="ganancia-total-display" class="text-success">$0.00</span>
                    </div>
                    <div class="summary-item">
                        <span>% Ganancia:</span>
                        <span id="porcentaje-ganancia-display" class="fw-bold">0.00%</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary btn-lg">Guardar Cambios</button>
            <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
        </div>
    </form>

    @* Plantilla oculta para añadir nuevas filas (usa la parcial de Alta) *@
    <div id="detalle-template" style="display: none;">
        <partial name="_DetallePromocionItem" model="new DetallesPromocionesVM.ModificarDetallePromocionVM()" view-data='new ViewDataDictionary(ViewData) { { "index", "__INDEX__" } }' />
    </div>

    @section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            const detallesContainer = $('#detalles-container');

            function inicializarSelect2(element) {
                element.select2({
                    placeholder: 'Buscar producto...',
                    minimumInputLength: 2,
                    ajax: {
                        url: '@Url.Action("BuscarProductosParaPromocion", "Promociones")',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) {
                            let idsSeleccionados = [];
                            $('.producto-search').not(element).each(function() {
                                let val = $(this).val();
                                if (val) { idsSeleccionados.push(val); }
                            });
                            return { term: params.term, idsExcluidos: idsSeleccionados };
                        },
                        processResults: function (data) { return { results: data }; }
                    }
                });
            }

            function recalcularTotales() {
                let costoTotal = 0;
                detallesContainer.find('.detalle-item').each(function() {
                    const row = $(this);
                    const costoUnitario = parseFloat(row.find('.costo-producto-unitario').val()) || 0;
                    const cantidad = parseFloat(row.find('.cantidad-producto').val()) || 0;
                    const costoDetalle = costoUnitario * cantidad;
                    costoTotal += costoDetalle;
                    row.find('.costo-detalle-display').text(costoDetalle.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }));
                });

                const precioPromocion = parseFloat(String($('#Precio').val()).replace(',', '.')) || 0;
                const ganancia = precioPromocion - costoTotal;
                const porcentajeGanancia = costoTotal > 0 ? (ganancia / costoTotal) : 0;

                $('#costo-total-display').text(costoTotal.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }));
                $('#ganancia-total-display').text(ganancia.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }));
                $('#porcentaje-ganancia-display').text(porcentajeGanancia.toLocaleString('es-AR', { style: 'percent', minimumFractionDigits: 2 }));
            }

            function actualizarVisibilidadBotonEliminar() {
                const filas = detallesContainer.find('.detalle-item');
                filas.find('.btn-eliminar-detalle').prop('disabled', filas.length <= 1);
            }

            function reindexarFilas() {
                detallesContainer.find('.detalle-item').each(function(index) {
                    $(this).find('input, select').each(function() {
                        const oldName = $(this).attr('name');
                        if (oldName) {
                            const propertyName = oldName.substring(oldName.lastIndexOf('.') + 1);
                            const newName = `DetallesPromocion[${index}].${propertyName}`;
                            $(this).attr('name', newName);
                        }
                    });
                });
                actualizarVisibilidadBotonEliminar();
                recalcularTotales();
            }

            // --- MANEJADORES DE EVENTOS ---
            $('#btn-agregar-detalle').click(function () {
                const nuevoIndex = detallesContainer.find('.detalle-item').length;
                $.get('@Url.Action("ObtenerVistaDetallePromocion", "Promociones")', { index: nuevoIndex }, function (data) {
                    const nuevaFila = $(data);
                    detallesContainer.append(nuevaFila);
                    inicializarSelect2(nuevaFila.find('.producto-search'));
                    reindexarFilas();
                });
            });

            detallesContainer.on('click', '.btn-eliminar-detalle', function () {
                $(this).closest('.detalle-item').remove();
                reindexarFilas();
            });
            
            detallesContainer.on('select2:select', '.producto-search', function (e) {
                const data = e.params.data;
                const costo = data.costo || 0;
                $(this).closest('.detalle-item').find('.costo-producto-unitario').val(costo);
                recalcularTotales();
            });

            detallesContainer.on('input', '.cantidad-producto', recalcularTotales);
            $('#Precio').on('input', recalcularTotales);

            // --- INICIALIZACIÓN ---
            detallesContainer.find('.producto-search').each(function() {
                inicializarSelect2($(this));
            });
            reindexarFilas(); // Es importante llamarla al inicio para calcular todo.
        });
    </script>
}

}
else
{
    @* --- CASO 2: LA PROMOCIÓN NO SE PUEDE MODIFICAR (Formulario Semi-Bloqueado) --- *@

    <form asp-action="Modificar" method="post" id="form-promocion">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="IdPromocion" />
        
        @* Pasamos los detalles originales en campos ocultos para que no se pierdan al guardar *@
        @for (var i = 0; i < Model.DetallesPromocion.Count; i++)
        {
            <input type="hidden" name="DetallesPromocion[@i].IdProducto" value="@Model.DetallesPromocion[i].IdProducto" />
            <input type="hidden" name="DetallesPromocion[@i].Cantidad" value="@Model.DetallesPromocion[i].Cantidad.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        }

        <h1>Modificar Promoción: @Model.Promocion</h1>
        <hr />

        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">Modificación Restringida</h4>
            <p>Esta promoción ya fue utilizada en ventas, por lo que su "receta" (productos y cantidades) no puede ser alterada. Solo puedes modificar el nombre, precio y las fechas de vigencia.</p>
        </div>

        <div class="row">
            <div class="col-md-7">
                @* --- DATOS GENERALES (Editables) --- *@
                <div class="card shadow-sm mb-4">
                    <div class="card-header"><h4>Datos Generales</h4></div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Promocion" class="form-label"></label>
                            <input asp-for="Promocion" class="form-control" />
                            <span asp-validation-for="Promocion" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label asp-for="Inicio" class="form-label"></label>
                                <input asp-for="Inicio" type="date" class="form-control" />
                                <span asp-validation-for="Inicio" class="text-danger"></span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label asp-for="Fin" class="form-label">Fecha de Fin (Opcional)</label>
                                <input asp-for="Fin" type="date" class="form-control" />
                                <span asp-validation-for="Fin" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- DETALLES DE PRODUCTOS (Solo Lectura) --- *@
                <div class="card shadow-sm">
                    <div class="card-header"><h4>Productos Incluidos (No editable)</h4></div>
                    <div class="card-body">
                        <div id="detalles-container">
                            @foreach (var detalle in Model.DetallesPromocion)
                            {
                                <div class="row detalle-item align-items-center mb-3 p-2 border rounded">
                                    <div class="col-md-6">
                                        <label class="form-label">Producto</label>
                                        <input asp-for="@detalle.NombreProducto" class="form-control producto-search" readonly>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="@detalle.Cantidad" class="form-label"></label>
                                        <input asp-for="@detalle.Cantidad" type="number" step="0.001" min="0.001" class="form-control cantidad-producto" readonly/>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Costo</label>
                                        <p class="form-control-plaintext fw-bold costo-detalle-display">$@detalle.CalcularCosto().ToString("N2")</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* --- COLUMNA DE RESUMEN --- *@
            <div class="col-md-5">
                <div class="summary-card">
                    <h4>Resumen de la Promoción</h4>
                    <hr>
                    <div class="mb-3">
                        <label asp-for="Precio" class="form-label fs-5">Precio de Venta Final</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Precio" type="number" step="0.01" id="Precio" class="form-control form-control-lg" />
                        </div>
                        <span asp-validation-for="Precio" class="text-danger"></span>
                    </div>
                    <div class="summary-item">
                        <span>Costo Total:</span>
                        <span id="costo-total-display" class="fw-bold text-danger">$0.00</span>
                    </div>
                    <div class="summary-item total">
                        <span>GANANCIA:</span>
                        <span id="ganancia-total-display" class="text-success">$0.00</span>
                    </div>
                    <div class="summary-item">
                        <span>% Ganancia:</span>
                        <span id="porcentaje-ganancia-display" class="fw-bold">0.00%</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary btn-lg">Guardar Cambios</button>
            <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
        </div>
    </form>
    @section Scripts{
        @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
        <script>
            $(document).ready(function() {
                // 1. Obtenemos el costo total (que es fijo) desde el modelo de C# UNA SOLA VEZ.
                //    Usamos Json.Serialize para asegurar que el número se escriba correctamente.
                const costoTotalFijo = @Json.Serialize(Model.CalcularCosto());

                // 2. Definimos la función que se ejecutará CADA VEZ que el precio cambie.
                function recalcularTotales() {
                    // Obtenemos el precio actual del input.
                    let precioPromocion = parseFloat(String($('#Precio').val()).replace(',', '.')) || 0;

                    // Calculamos la ganancia y el porcentaje USANDO JAVASCRIPT.
                    const ganancia = precioPromocion - costoTotalFijo;
                    const porcentajeGanancia = costoTotalFijo > 0 ? (ganancia / costoTotalFijo) : 0;

                    // Actualizamos los campos de texto en la vista.
                    $('#costo-total-display').text(costoTotalFijo.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }));
                    $('#ganancia-total-display').text(ganancia.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' }));
                    $('#porcentaje-ganancia-display').text(porcentajeGanancia.toLocaleString('es-AR', { style: 'percent', minimumFractionDigits: 2 }));
                }

                // 3. Vinculamos la función al evento 'input' del campo de precio.
                $('#Precio').on('input', recalcularTotales);

                // 4. Ejecutamos la función una vez al cargar la página para mostrar los valores iniciales.
                recalcularTotales();
            });
        </script>
    }
}

