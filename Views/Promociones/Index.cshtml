@model IEnumerable<PromocionesVM.ListarPromocionesVM>
@{
    ViewData["Title"] = "Promociones";
}

<div class="filter-panel">
    <div class="filter-title">Filtros</div>
    <div class="row g-2 align-items-center">
        <div class="col-md-8">
            <label class="form-label">Buscar</label>
            <input type="text" id="buscador-promocion" name="busqueda" class="form-control"
                   placeholder="Buscar por nombre de promoción o producto..." value="@ViewData["BusquedaActual"]" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Estado</label>
            <div class="form-check form-switch pt-1">
                <input class="form-check-input" id="mostrar-inactivos" type="checkbox" name="Inactivos" />
                <label class="form-check-label" for="mostrar-inactivos">Ver Inactivas</label>
            </div>
        </div>
    </div>
</div>

<div class="table-wrapper">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Promoción</th>
                <th>Productos</th>
                <th>Stock</th>
                <th>Costo</th>
                <th>Precio</th>
                <th>Ganancia</th>
                <th>% Ganancia</th>
                <th>Inicio/Fin</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-promociones-body">
            <partial name="_PromocionesTabla" model="Model" />
        </tbody>
    </table>
</div>

<a asp-action="Alta" class="btn btn-float">+</a>

@section Scripts {
    <script>
        $(document).ready(function () {
            function actualizarTablaPromociones() {
                $.ajax({
                    url: '@Url.Action("_BuscarPromociones", "Promociones")',
                    type: 'GET',
                    data: { busqueda: $('#buscador-promocion').val(), inactivos: $('#mostrar-inactivos').is(':checked') },
                    success: function (result) { $('#tabla-promociones-body').html(result); },
                    error: function (err) { console.error("Error al buscar promociones:", err); }
                });
            }
            $('#buscador-promocion').on('keyup', actualizarTablaPromociones);
            $('#mostrar-inactivos').on('change', actualizarTablaPromociones);
        });
    </script>
}