@model ConsumoVM.AltaConsumoVM
@{
    ViewData["Title"] = "Registrar Consumo";
}

<form asp-action="Alta" method="post" id="form-consumo">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <!-- columna izquierda: datos + productos -->
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header">Datos generales</div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label asp-for="Fecha" class="form-label">Fecha</label>
                        <input asp-for="Fecha" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Detalle" class="form-label">Detalle (opcional)</label>
                        <input asp-for="Detalle" type="text" class="form-control" placeholder="Ejemplo: consumo personal del día" />
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">Productos consumidos</div>
                <div class="card-body">
                    <div id="detalles-container">
                        <div class="fila-detalle row g-2 mb-2 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label">Producto</label>
                                <select name="Detalles[0].IdProducto" class="form-select select-producto">
                                    <option value="">— Seleccionar —</option>
                                    @foreach (var p in Model.ProductosActivos)
                                    {
                                        <option value="@p.IdProducto"
                                                data-costo="@p.Costo.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-stock="@p.Stock.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)">
                                            @p.Producto (stock: @p.Stock.ToString("N3", CG.CulturaES))
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Cant.</label>
                                <input type="number" name="Detalles[0].Cantidad" class="form-control input-cantidad" step="0.001" min="0.001" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Costo unit. ($)</label>
                                <input type="number" name="Detalles[0].CostoUnitario" class="form-control input-costo" step="0.01" min="0" readonly />
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button type="button" class="btn btn-danger btn-sm btn-eliminar-fila" title="Eliminar">✕</button>
                            </div>
                        </div>
                    </div>
                    <button type="button" id="btn-agregar" class="btn btn-outline-primary btn-sm mt-1">+ Agregar producto</button>
                </div>
            </div>
        </div>

        <!-- columna derecha: resumen -->
        <div class="col-lg-4">
            <div class="summary-card">
                <h6 class="fw-bold mb-3">Resumen</h6>
                <div id="resumen-items"></div>
                <div class="summary-item total">
                    <span>Costo total</span>
                    <span id="resumen-total">$0,00</span>
                </div>
                <hr />
                <button type="submit" class="btn btn-primary w-100">💾 Guardar consumo</button>
                <a asp-action="Index" class="btn btn-secondary w-100 mt-2">Cancelar</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
$(document).ready(function() {
    let idx = 1;

    // Cuando se elige un producto → pre-cargar costo
    $(document).on('change', '.select-producto', function() {
        const opt  = $(this).find(':selected');
        const costo = opt.data('costo') || 0;
        $(this).closest('.fila-detalle').find('.input-costo').val(costo);
        calcularResumen();
    });

    $(document).on('input', '.input-cantidad, .input-costo', calcularResumen);

    $('#btn-agregar').on('click', function() {
        const fila = `
        <div class="fila-detalle row g-2 mb-2 align-items-end">
            <div class="col-md-5">
                <select name="Detalles[${idx}].IdProducto" class="form-select select-producto">
                    <option value="">— Seleccionar —</option>
                    @foreach (var p in Model.ProductosActivos)
                    {<option value="@p.IdProducto" data-costo="@p.Costo.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" data-stock="@p.Stock.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)">@p.Producto (stock: @p.Stock.ToString("N3", CG.CulturaES))</option>}
                </select>
            </div>
            <div class="col-md-3">
                <input type="number" name="Detalles[${idx}].Cantidad" class="form-control input-cantidad" step="0.001" min="0.001" />
            </div>
            <div class="col-md-3">
                <input type="number" name="Detalles[${idx}].CostoUnitario" class="form-control input-costo" step="0.01" min="0" readonly />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="button" class="btn btn-danger btn-sm btn-eliminar-fila">✕</button>
            </div>
        </div>`;
        $('#detalles-container').append(fila);
        idx++;
    });

    $(document).on('click', '.btn-eliminar-fila', function() {
        if ($('.fila-detalle').length > 1) {
            $(this).closest('.fila-detalle').remove();
            calcularResumen();
        }
    });

    function calcularResumen() {
        let total = 0;
        let html = '';
        $('.fila-detalle').each(function() {
            const nombre = $(this).find('.select-producto option:selected').text().split(' (')[0];
            const cant   = parseFloat($(this).find('.input-cantidad').val()) || 0;
            const costo  = parseFloat($(this).find('.input-costo').val()) || 0;
            if (cant > 0 && nombre) {
                const sub = cant * costo;
                total += sub;
                html += `<div class="summary-item"><span>${nombre} ×${cant}</span><span>$${sub.toFixed(2)}</span></div>`;
            }
        });
        $('#resumen-items').html(html);
        $('#resumen-total').text('$' + total.toLocaleString('es-AR', {minimumFractionDigits:2}));
    }

    calcularResumen();
});
</script>
}
