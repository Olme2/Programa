@model ProduccionVM.IndexProduccionVM
@{
    ViewData["Title"] = "Produccion";
    var totalCosto = Model.Producciones.Sum(p => p.TotalCosto);
}

<div class="filter-panel">
    <div class="filter-title">Filtros</div>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label asp-for="FechaInicio" class="form-label">Fecha Inicio</label>
            <input asp-for="FechaInicio" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="FechaFin" class="form-label">Fecha Fin</label>
            <input asp-for="FechaFin" type="date" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>
    </form>
</div>

<div class="stat-row">
    <div class="stat-chip">
        <div class="label">Registros</div>
        <div class="value">@Model.Producciones.Count</div>
    </div>
    <div class="stat-chip warning">
        <div class="label">Costo Produccion</div>
        <div class="value">$@totalCosto.ToString("N2", CG.CulturaES)</div>
    </div>
</div>

<div class="table-wrapper">
    <table class="table table-hover table-sm">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Productos retirados</th>
                <th>Costo</th>
                <th>Detalle</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Producciones.Any())
            {
                @foreach (var p in Model.Producciones)
                {
                    <tr>
                        <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@p.Hora.ToString("HH:mm")</td>
                        <td>@Html.Raw(p.Productos.Replace(", ", "<br>"))</td>
                        <td class="text-warning fw-bold">$@p.TotalCosto.ToString("N2", CG.CulturaES)</td>
                        <td><span title="@p.Detalle">@(p.Detalle?.Length > 20 ? p.Detalle.Substring(0, 20) + "..." : p.Detalle ?? "-")</span></td>
                        <td>
                            <div class="action-buttons">
                                <a asp-action="Modificar" asp-route-id="@p.IdProduccion" class="btn btn-warning btn-sm">Modificar</a>
                                <form asp-action="Eliminar" method="post" onsubmit="return confirm('Eliminar este retiro? El stock sera devuelto.')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.IdProduccion" />
                                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center text-muted py-3">No hay retiros de produccion en el periodo seleccionado.</td></tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Alta" class="btn btn-float">+</a>
