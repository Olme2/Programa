@model MetodosVM.ModificarMetodoDePagoVM

<h2>Eliminar Método de Pago</h2>

<h4>¿Estás seguro que deseas eliminar el siguiente método de pago "@Model.Metodo"?</h4>

<form asp-action="EliminarMetodoDePago" method="post">
    <input type="hidden" asp-for="IdMetodo"/>
    <div class="mt-3">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form> 