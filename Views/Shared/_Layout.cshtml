<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Sistema Pollería</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/entornoPolleria.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>

<div class="app-wrapper">

    <!-- ── Sidebar ───────────────────────────────────────────── -->
    <aside class="sidebar">
        <a class="sidebar-brand" asp-controller="Ventas" asp-action="Alta">
            <div class="sidebar-brand-icon">🍗</div>
            <div>
                <div class="sidebar-brand-text">Pollería</div>
                <div class="sidebar-brand-sub">Sistema de gestión</div>
            </div>
        </a>

        <div class="sidebar-section-label">Principal</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="Ventas" asp-action="Alta"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Ventas" && ViewContext.RouteData.Values["action"]?.ToString() == "Alta" ? "active" : "")">
                    <span class="nav-icon">🛒</span> Nueva Venta
                </a>
            </li>
            <li>
                <a asp-controller="Ventas" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Ventas" && ViewContext.RouteData.Values["action"]?.ToString() != "Alta" ? "active" : "")">
                    <span class="nav-icon">📋</span> Ventas
                </a>
            </li>
        </ul>

        <div class="sidebar-section-label">Inventario</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="Productos" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Productos" ? "active" : "")">
                    <span class="nav-icon">📦</span> Productos
                </a>
            </li>
            <li>
                <a asp-controller="Compras" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Compras" ? "active" : "")">
                    <span class="nav-icon">🛍️</span> Compras
                </a>
            </li>
            <li>
                <a asp-controller="Proveedores" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Proveedores" ? "active" : "")">
                    <span class="nav-icon">🏭</span> Proveedores
                </a>
            </li>
        </ul>

        <div class="sidebar-section-label">Configuración</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="Promociones" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Promociones" ? "active" : "")">
                    <span class="nav-icon">🎁</span> Promociones
                </a>
            </li>
            <li>
                <a asp-controller="MetodosPago" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "MetodosPago" ? "active" : "")">
                    <span class="nav-icon">💳</span> Métodos de Pago
                </a>
            </li>
        </ul>
    </aside>

    <!-- ── Main content ───────────────────────────────────────── -->
    <div class="main-content">
        <!-- Topbar -->
        <div class="topbar">
            <span class="topbar-title">@(ViewData["Title"] ?? "Sistema Pollería")</span>
        </div>

        <!-- Alerts -->
        <div class="page-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
