@model List<ProductosVM.ListarProductosVM>
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Globalization

@{
    var nf = new NumberFormatInfo {
        NumberDecimalSeparator = ",",
        NumberGroupSeparator = "."
    };
}

<h2>Listado de Productos</h2>
<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Proveedor</th>
            <th>Stock</th>
            <th>Costo</th>
            <th>Precio</th>
            <th>Ganancia</th>
            <th>% Ganancia</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Producto</td>
                <td>@producto.Proveedor</td>
                <td>@producto.Stock.ToString("N2", nf) kg</td>
                <td>$@producto.Costo.ToString("N2", nf)</td>
                <td>$@producto.Precio.ToString("N2", nf)</td>
                <td>$@producto.Ganancia.ToString("N2", nf)</td>
                <td>@producto.PorcentajeGanancia %</td>
                <td>
                    <a asp-action="ModificarProducto" asp-route-id="@producto.IdProducto" class="btn btn-warning btn-sm">Modificar</a>
                    <a asp-action="EliminarProducto" asp-route-id="@producto.IdProducto" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="AltaProducto" class="btn btn-primary">Agregar Producto</a>
