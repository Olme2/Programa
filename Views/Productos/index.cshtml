@model List<ProductosVM.ListarProductosVM>
@{
    ViewData["Title"] = "Productos";
}

<h1>Listado de Productos</h1>

<div class="row g-3 align-items-center mb-3">
    <div class="col-md-4">
        <div class="input-group">
            <span class="input-group-text">Ordenar por</span>
            <select id="ordenar-por" name="ordenarPor" class="form-select">
                <option value="alfabetico" selected="@(ViewData["OrdenActual"]?.ToString() == "alfabetico")">Nombre (A-Z)</option>
                <option value="stock" selected="@(ViewData["OrdenActual"]?.ToString() == "stock")">Stock (Mayor a Menor)</option>
            </select>
        </div>
    </div>
    <div class="col-md-6">
        <input type="text" id="buscador-producto" name="busqueda" class="form-control" placeholder="Buscar por Producto o Proveedor..." value="@ViewData["BusquedaActual"]" />
    </div>
    <div class="col-md-2">
    <div class="form-check form-switch bg-light border rounded p-2 d-flex justify-content-center align-items-center h-100">
        <input class="form-check-input me-2" id="mostrar-inactivos" type="checkbox" name="Inactivos">
        <label class="form-check-label" for="mostrar-inactivos">Ver Inactivos</label>
    </div>
</div>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Producto</th>
                <th>Proveedor</th>
                <th>Stock</th>
                <th>Costo</th>
                <th>Precio</th>
                <th>Ganancia</th>
                <th>% Ganancia</th>
                <th>Venta Semanal</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-productos-body">
            @await Html.PartialAsync("_ProductosTabla", Model)
        </tbody>
    </table>
</div>

<a asp-action="Alta" class="btn btn-success btn-lg btn-float">+</a>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}