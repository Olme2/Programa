@model ProductosVM.IndexProductosVM
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <button type="button" id="btnCopiarListaPrecios" class="btn btn-outline-primary btn-sm">
        📋 Copiar Lista de Precios
    </button>
</div>

<!-- Filtros -->
<div class="filter-panel">
    <div class="filter-title">Filtros</div>
    <form id="filtro-form" class="row g-2 align-items-end">
        <div class="col-xl-4 col-md-4">
            <label asp-for="OrdenarPor" class="form-label">Ordenar por</label>
            <select asp-for="OrdenarPor" class="form-select filtro-control">
                <option value="alfabetico">Nombre (A-Z)</option>
                <option value="stock">Stock (Menor a Mayor)</option>
            </select>
        </div>
        <div class="col-xl-4 col-md-4">
            <label asp-for="Busqueda" class="form-label">Búsqueda</label>
            <input asp-for="Busqueda" type="text" class="form-control filtro-control" placeholder="Buscar por Producto o Proveedor..." />
        </div>
        <div class="col-xl-2 col-md-4">
            <label class="form-label">Inactivos</label>
            <div class="form-check form-switch pt-1">
                <input asp-for="Inactivos" class="form-check-input filtro-control" type="checkbox" />
                <label asp-for="Inactivos" class="form-check-label">Ver Inactivos</label>
            </div>
        </div>
        <div class="col-xl-2 col-auto">
            <a asp-action="ResetearFiltros" class="btn btn-secondary w-100">↺ Resetear</a>
        </div>
    </form>
</div>

<!-- Tabla -->
<div class="table-wrapper">
    <table class="table table-hover table-sm">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Proveedor</th>
                <th>Stock</th>
                <th>Costo</th>
                <th>Precio</th>
                <th>Ganancia</th>
                <th>% Ganancia</th>
                <th>Venta Semanal</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-productos-body">
            <partial name="_ProductosTabla" model="Model.Productos" />
        </tbody>
    </table>
</div>

<a asp-action="Alta" class="btn btn-float">+</a>

@section Scripts {
    <script>
        $(document).ready(function() {
            let debounceTimeout;

            function actualizarTablaProductos() {
                $.ajax({
                    url: '@Url.Action("FiltrarProductos", "Productos")',
                    type: 'POST',
                    data: $('#filtro-form').serialize(),
                    success: function(response) { $('#tabla-productos-body').html(response); },
                    error: function() { $('#tabla-productos-body').html('<tr><td colspan="9" class="text-center text-danger">Error al cargar los productos.</td></tr>'); }
                });
            }

            $('.filtro-control').on('change', function() { actualizarTablaProductos(); });
            $('#Busqueda').on('keyup', function() {
                clearTimeout(debounceTimeout);
                debounceTimeout = setTimeout(actualizarTablaProductos, 300);
            });
            actualizarTablaProductos();

            $('#btnCopiarListaPrecios').on('click', function() {
                const boton = $(this);
                boton.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Copiando...');
                $.ajax({
                    url: '@Url.Action("GenerarListaDePreciosTexto", "Productos")',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            navigator.clipboard.writeText(response.listaDePrecios).then(function() {
                                boton.removeClass('btn-outline-primary').addClass('btn-success').html('✅ ¡Copiado!');
                            }, function() {
                                boton.removeClass('btn-outline-primary').addClass('btn-danger').html('❌ Error al copiar');
                            });
                        } else {
                            boton.removeClass('btn-outline-primary').addClass('btn-danger').html('❌ Error en servidor');
                        }
                    },
                    error: function() { boton.addClass('btn-danger').html('❌ Falló la conexión'); },
                    complete: function() {
                        setTimeout(function() {
                            boton.prop('disabled', false).removeClass('btn-success btn-danger').addClass('btn-outline-primary').html('📋 Copiar Lista de Precios');
                        }, 3000);
                    }
                });
            });
        });
    </script>
}