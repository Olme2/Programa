@model ProductosVM.ModificarProductoVM
@{
    ViewData["Title"] = "Modificar Producto";
}

<h1>Modificar Producto</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Modificar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" asp-for="IdProducto" />
            
            <div class="form-group mb-3">
                <label asp-for="Producto" class="control-label"></label>
                <input asp-for="Producto" class="form-control" />
                <span asp-validation-for="Producto" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="IdProveedor" class="control-label"></label>
                <select asp-for="IdProveedor" class="form-control" id="proveedor-search">
                    @if (Model.IdProveedor > 0)
                    {
                        var proveedorSeleccionado = Model.Proveedores.FirstOrDefault(p => p.IdProveedor == Model.IdProveedor);
                        if (proveedorSeleccionado != null)
                        {
                            <option value="@proveedorSeleccionado.IdProveedor" selected>@proveedorSeleccionado.Proveedor</option>
                        }
                    }
                </select>
                <span asp-validation-for="IdProveedor" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="form-group mb-3">
                    <label asp-for="Stock" class="control-label">Stock (Calculado)</label>
                    <input asp-for="Stock" class="form-control" type="number" step="0.001" />
                    <span asp-validation-for="Stock" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Costo" class="control-label">Costo (Derivado de compras)</label>
                    <input asp-for="Costo" class="form-control" type="number" step="0.001" />
                    <span asp-validation-for="Costo" class="text-danger"></span>
                </div>
                <div class="col">
                    <div class="form-group mb-3">
                        <label asp-for="Precio" class="control-label"></label>
                        <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Precio" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" asp-for="Activo">
                    <label class="form-check-label" asp-for="Activo">¿Está activo?</label>
                </div>
                <span asp-validation-for="Activo" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-4">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script type="text/javascript">
        $(document).ready(function() {
            $('#proveedor-search').select2({
                placeholder: "-- Escriba para buscar un proveedor --",
                minimumInputLength: 0,
                ajax: {
                    url: '@Url.Action("BuscarProveedores", "Proveedores")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { term: params.term };
                    },
                    processResults: function (data) {
                        return { results: data };
                    },
                    cache: true
                }
            });
            // --- LÓGICA PARA BLOQUEAR EL CAMPO STOCK ---
    
            // 1. Seleccionamos el campo de stock por su ID y lo hacemos de solo lectura.
            const stockInput = $('#stock-no-editable');
            const costoInput = $('#costo-no-editable');
            stockInput.prop('readonly', true);
            costoInput.prop('readonly', true);
            // 2. Agregamos un evento para cuando el usuario haga clic en él.
            stockInput.on('click', function() {
                alert("No se puede modificar el stock. Su valor es calculado a partir de las ventas y compras.");
            });
            costoInput.on('click', function() {
                alert("No se puede modificar el costo. Su valor es calculado a partir de las compras.");
            });
        
            // 3. (Opcional) Cambiamos el cursor para que parezca no editable.
            stockInput.css('cursor', 'not-allowed');
            costoInput.css('cursor', 'not-allowed');

        });
        // --- INICIO DE LA CORRECCIÓN DEFINITIVA ---
        // Pega este bloque de código AFUERA del $(document).ready(), pero dentro del <script>
        // Esto crea un único manejador de eventos para toda la página.
        $(document).on('select2:open', () => {
            // Usamos un pequeño delay para darle tiempo al navegador a renderizar el campo de búsqueda.
            // Aumentamos a 50ms para máxima compatibilidad.
            setTimeout(() => {
                // Buscamos el campo de búsqueda que está visible en el DOM y le damos el foco.
                const searchField = document.querySelector('.select2-container--open .select2-search__field');
                if (searchField) {
                    searchField.focus();
                }
            }, 50); 
        });
        // --- FIN DE LA CORRECCIÓN DEFINITIVA ---
    </script>
}