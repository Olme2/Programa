@model List<ProductosVM.ListarProductosVM>

@{
    var busqueda = ViewData["BusquedaActual"] as string;

    // Función para resaltar las coincidencias de la búsqueda.
    Func<string, HtmlString> ResaltarCoincidencia = (texto) => 
    {
        if (string.IsNullOrEmpty(busqueda) || string.IsNullOrEmpty(texto) || !texto.Contains(busqueda, StringComparison.CurrentCultureIgnoreCase))
        {
            return new HtmlString(texto.Replace("\n", "<br />"));
        }
        var regex = new System.Text.RegularExpressions.Regex(busqueda, System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        string textoResaltado = regex.Replace(texto, $"<span class='highlight'>$&</span>");
        return new HtmlString(textoResaltado.Replace("\n", "<br />"));
    };
}
@if(Model.Any()){
    @foreach (var producto in Model)
    {
        string filaInactivaClass = !producto.Activo ? "table-secondary" : "";
        <tr class="@filaInactivaClass">
            <td>@ResaltarCoincidencia(producto.Producto)</td>
            <td>@ResaltarCoincidencia(producto.Proveedor)</td>
            <td>@producto.Stock.ToString("N3", CG.CulturaES)</td>
            <td>$@producto.Costo.ToString("N2", CG.CulturaES)</td>
            <td>$@producto.Precio.ToString("N2", CG.CulturaES)</td>
            <td>$@producto.Ganancia.ToString("N2", CG.CulturaES)</td>
            <td>@producto.PorcentajeGanancia.ToString("N2", CG.CulturaES)%</td>
            <td>@producto.VentaSemanal.ToString("N3", CG.CulturaES)</td>
            <td>
                <a asp-action="Estadisticas" asp-route-id="@producto.IdProducto" class="btn btn-info btn-sm" title="Ver estadísticas">📊</a>
                <a asp-action="Modificar" asp-route-id="@producto.IdProducto" class="btn btn-warning btn-sm">Modificar</a>
                @if (producto.EsEliminable)
                {
                    <a asp-action="Eliminar" asp-route-id="@producto.IdProducto" class="btn btn-danger btn-sm">Eliminar</a>
                }
                else
                {
                    <a class="btn btn-secondary btn-sm disabled" title="No se puede eliminar, está en uso">Eliminar</a>
                }
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="12" class="text-center"><h3>No se encontraron productos para los filtros seleccionados.</h3></td>
    </tr>
}