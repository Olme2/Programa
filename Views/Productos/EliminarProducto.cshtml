@model ListarProductosViewModel

@using System.Globalization

@{
    var nf = new NumberFormatInfo {
        NumberDecimalSeparator = ",",
        NumberGroupSeparator = "."
    };
}

<h3>Eliminar producto</h3>
<p>¿Estás seguro que deseas eliminar el producto "<strong>@Model.Producto</strong>"?</p>
<ul>
    <li><strong>Proveedor:</strong> @Model.Proveedor</li>
    <li><strong>Stock:</strong> @Model.Stock.ToString("N2", nf)</li>
    <li><strong>Costo:</strong> $@Model.Costo.ToString("N2", nf)</li>
    <li><strong>Precio:</strong> $@Model.Precio.ToString("N2",nf)</li>
    <li><strong>Ganancia:</strong> $@Model.Ganancia.ToString("N2",nf)</li>
    <li><strong>% Ganancia:</strong> @Model.PorcentajeGanancia.ToString("N2",nf)%</li>
</ul>
<form asp-controller="Productos" asp-action="EliminarProducto" method="post">
    <input type="hidden" asp-for="IdProducto" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>