@model ProductosVM.ListarProductosVM
@{
    ViewData["Title"] = "Eliminar Producto";
}

<h1>Confirmar Eliminación</h1>

<h3 class="text-danger">¿Está seguro que desea eliminar este producto?</h3>
<p class="text-muted">Esta acción no se puede deshacer.</p>

<hr />

<div>
    <h4>Producto a Eliminar:</h4>
    <dl class="row">
        <dt class="col-sm-3">
            Producto
        </dt>
        <dd class="col-sm-9">
            @Model.Producto
        </dd>
        
        <dt class="col-sm-3">
            Proveedor
        </dt>
        <dd class="col-sm-9">
            @Model.Proveedor
        </dd>
        
        <dt class="col-sm-3">
            Stock Actual
        </dt>
        <dd class="col-sm-9">
            @Model.Stock
        </dd>

        <dt class="col-sm-3">
            Costo
        </dt>
        <dd class="col-sm-9">
            @Model.Costo.ToString("C")
        </dd>
        
        <dt class="col-sm-3">
            Precio
        </dt>
        <dd class="col-sm-9">
            @Model.Precio.ToString("C")
        </dd>
    </dl>
    
    <form asp-action="Eliminar" method="post">
        <input type="hidden" asp-for="IdProducto" />
        <input type="submit" value="Eliminar Definitivamente" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>