@model ProductosVM.AltaProductoVM
@{
    ViewData["Title"] = "Nuevo Producto";
}

<h1>Crear Nuevo Producto</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Alta" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Producto" class="control-label"></label>
                <input asp-for="Producto" class="form-control" placeholder="Ej: Milanesa de Pollo" />
                <span asp-validation-for="Producto" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="IdProveedor" class="control-label"></label>
                <select asp-for="IdProveedor" class="form-control" id="proveedor-search">
                    @if(Model.IdProveedor > 0){
                        <option value="@Model.IdProveedor">@Model.Proveedor</option>
                    }
                </select>
                <span asp-validation-for="IdProveedor" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-group mb-3">
                        <label asp-for="Stock" class="control-label"></label>
                        <input asp-for="Stock" class="form-control" type="number" step="0.001"  placeholder="Ej: 1.000,000" value="@(Model.Stock==-1 ? "" : Model.Stock)"/>
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>
                <div class="col">
                    <div class="form-group mb-3">
                        <label asp-for="Costo" class="control-label"></label>
                        <input asp-for="Costo" class="form-control" type="number" step="0.01" placeholder="Ej: 1.000,00" value="@(Model.Costo>0 ? Model.Costo : "")"/>
                        <span asp-validation-for="Costo" class="text-danger"></span>
                    </div>
                </div>
                <div class="col">
                    <div class="form-group mb-3">
                        <label asp-for="Precio" class="control-label"></label>
                        <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="Ej: 1.000,00" value="@(Model.Precio>0 ? Model.Costo : "")"/>
                        <span asp-validation-for="Precio" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="form-group mt-4">
                <input type="submit" value="Guardar Producto" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script type="text/javascript">
        // Este código se ejecuta cuando la página está lista.
        $(document).ready(function() {
            // Inicializamos Select2 en nuestro elemento <select>
            $('#proveedor-search').select2({
                placeholder: "-- Escriba para buscar un proveedor --",
                minimumInputLength: 0, // Empezar a buscar después de 2 caracteres
                ajax: {
                    url: '@Url.Action("BuscarProveedores", "Proveedores")', // Llama a nuestro endpoint
                    dataType: 'json',
                    delay: 0, // Espera 250ms después de que el usuario deja de escribir
                    data: function (params) {
                        return {
                            term: params.term // El texto que el usuario escribió
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data
                        };
                    },
                    cache: true
                }
            });
        });
        // --- INICIO DE LA CORRECCIÓN DEFINITIVA ---
        // Pega este bloque de código AFUERA del $(document).ready(), pero dentro del <script>
        // Esto crea un único manejador de eventos para toda la página.
        $(document).on('select2:open', () => {
            // Usamos un pequeño delay para darle tiempo al navegador a renderizar el campo de búsqueda.
            // Aumentamos a 50ms para máxima compatibilidad.
            setTimeout(() => {
                // Buscamos el campo de búsqueda que está visible en el DOM y le damos el foco.
                const searchField = document.querySelector('.select2-container--open .select2-search__field');
                if (searchField) {
                    searchField.focus();
                }
            }, 50); 
        });
        // --- FIN DE LA CORRECCIÓN DEFINITIVA ---
    </script>
}